NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
MONGODB_URI=mongodb://localhost:27017/job_board
WEB_ORIGIN=http://localhost:5173
# Safe public browser configuration. It is visible in the built client.
VITE_API_BASE_URL=http://localhost:3000
# MongoDB Search is opt-in; local Docker, tests, and CI use deterministic basic mode.
JOB_SEARCH_MODE=basic
ATLAS_SEARCH_INDEX=
LOG_LEVEL=debug
# Requests above this threshold emit a structured slow-request warning.
SLOW_REQUEST_THRESHOLD_MS=1000
# Deployment metadata only. Never supply secrets here.
APP_VERSION=0.1.0
APP_REVISION=local
REQUEST_BODY_LIMIT=102400
# Keep 0 unless the API is directly behind a known number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
ACCESS_TOKEN_SECRET=replace-with-a-unique-32-character-minimum-secret
ACCESS_TOKEN_ISSUER=job-board-api
ACCESS_TOKEN_AUDIENCE=job-board-web
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7
# Development uses a no-network console provider. Production requires EMAIL_PROVIDER=smtp and valid SMTP settings.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@job-board.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Required in production for private resume storage. Leave blank only when using a test provider.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
