{
  "name": "@job-board/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @job-board/contracts && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@job-board/contracts": "*",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.0.2",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "mongoose": "9.9.4",
    "multer": "2.3.0",
    "nodemailer": "^9.0.6",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
